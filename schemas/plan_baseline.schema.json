{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://node1.ai/schemas/plan_baseline/v1",
  "title": "Plan Baseline",
  "description": "Hash-bound execution plan that must be approved before build starts.",
  "type": "object",
  "required": ["plan_id", "version", "title", "steps", "content_sha256", "approved_by", "approved_at"],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_number", "description", "risk_class"],
        "properties": {
          "step_number": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "risk_class": {
            "type": "string",
            "enum": ["GREEN", "YELLOW", "RED"]
          },
          "estimated_duration": { "type": "string" },
          "dependencies": {
            "type": "array",
            "items": { "type": "integer" }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the canonical plan content at approval time"
    },
    "approved_by": {
      "type": "string",
      "description": "Identity of the human who approved this baseline"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "drift_tolerance": {
      "type": "object",
      "properties": {
        "max_new_steps": { "type": "integer", "default": 2 },
        "max_scope_expansion_percent": { "type": "integer", "default": 20 }
      },
      "additionalProperties": false,
      "description": "How much the plan can change before re-approval is required"
    }
  },
  "additionalProperties": false
}
